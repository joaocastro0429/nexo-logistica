{
  "name": "nexo-logistica",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "seed": "npm run seed --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "typecheck": "npm run build --workspace backend && npm run typecheck --workspace frontend",
    "test:http": "npm run test:http --workspace backend",
    "test:integration": "npm run test:integration --workspace backend"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
