{
  "name": "nexo-logistica",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "seed": "npm run seed --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "typecheck": "npm run build --workspace backend && npm run typecheck --workspace frontend",
    "test:http": "npm run test:http --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:test": "docker compose --profile test run --build --rm tests"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  },
  "overrides": {
    "multer": "^2.4.0",
    "postcss": "^8.5.28"
  }
}
