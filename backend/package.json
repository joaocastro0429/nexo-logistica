{
  "name": "nexo-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -- sh -c 'npm run build && node --watch dist/src/main.js'",
    "start": "node dist/src/main.js",
    "seed": "npm run build && node dist/scripts/seed.js",
    "test": "npm run build && node --test dist/tests/frete.test.js dist/tests/painel.test.js dist/tests/operacao.test.js dist/tests/operacao-http.test.js dist/tests/auth.test.js dist/tests/oauth.test.js dist/tests/auth-http.test.js dist/tests/application.test.js",
    "test:http": "node tests/http.mjs",
    "test:integration": "npm run build && node tests/integracao.mjs",
    "test:services": "npm run build && node --test dist/tests/*.test.js",
    "migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@vercel/functions": "^3.9.8",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "otpauth": "^9.5.2",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "multer": "^2.4.0"
  }
}
