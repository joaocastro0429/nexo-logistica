{
  "name": "nexo-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "seed": "npm run build && node dist/scripts/seed.js",
    "test": "npm run build && node --test dist/tests/frete.test.js",
    "test:http": "node tests/http.mjs",
    "test:integration": "npm run build && node tests/integracao.mjs",
    "test:services": "npm run build && node --test dist/tests/*.test.js",
    "import:sqlite": "npm run build && node dist/scripts/import-sqlite.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "mysql2": "^3.24.4",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
